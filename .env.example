# Copia este archivo a `.env` y ajusta los valores. NUNCA commitees `.env`.

# Puerto y dirección de escucha del servidor (host).
# En producción (gym-node-02) se planea: BIND_ADDRESS=192.168.1.134 y PORT=3002.
PORT=3000
BIND_ADDRESS=127.0.0.1

# Contraseña de administración. Si no se define, el servidor genera una
# aleatoria y la imprime UNA vez en consola al arrancar (solo para desarrollo).
# En producción SIEMPRE definirla (mínimo 8 caracteres).
ADMIN_PASSWORD=cambia-esta-contrasena

# Ruta del archivo SQLite (default: data/sales.db)
DB_PATH=data/sales.db

# Opcional: protege los endpoints de venta (POST /api/sales y GET /api/sales/:id)
# con la cabecera X-Seller-Token. El frontend la pide una vez y la conserva en
# localStorage. Déjala vacía para deshabilitarla.
SELLER_TOKEN=

# true solo si el servidor se sirve por HTTPS (cookie de sesión con Secure).
# Detrás de un reverse proxy con TLS: COOKIE_SECURE=true.
COOKIE_SECURE=false

# true si el servidor va detrás de un reverse proxy (nginx/traefik), para
# respetar X-Forwarded-For en el rate-limit del login. Default false.
TRUST_PROXY=false
